# Copy to .env and fill in. .env is gitignored.

# Classic GitHub token with NO scopes checked. It only lifts the API rate limit
# from 60/hr to 5,000/hr. Create one at https://github.com/settings/tokens/new
GITHUB_TOKEN=

# Any OpenAI-compatible endpoint. See DEPLOY.md for the Vast.ai llama.cpp setup.
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M

# Optional; llama.cpp ignores it, hosted APIs need it.
# MODEL_API_KEY=
